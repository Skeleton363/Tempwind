+/* Tempwind: the scheduler's entries (wine-unix.md, section 9; abi.md,
+ * "Host entries of the Unix side"). Nothing polls the server's fds in the
+ * process; its timeouts run from the JS scheduler. */
+
+/* Ticks until the earliest timeout, 0 if one is due, -1 if none. It ignores
+ * the KUSER tick (set_current_time runs at every request and green switch)
+ * and the registry's periodic save. */
+timeout_t inproc_server_next_timeout(void)
+{
+    timeout_t ret = -1, diff;
+    struct timeout_user *timeout;
+
+    LIST_FOR_EACH_ENTRY( timeout, &abs_timeout_list, struct timeout_user, entry )
+    {
+        if (inproc_is_registry_save( timeout )) continue;
+        diff = timeout->when - current_time;
+        ret = diff < 0 ? 0 : diff;
+        break;
+    }
+    LIST_FOR_EACH_ENTRY( timeout, &rel_timeout_list, struct timeout_user, entry )
+    {
+        if (inproc_is_registry_save( timeout )) continue;
+        diff = -timeout->when - monotonic_time;
+        if (diff < 0) diff = 0;
+        if (ret == -1 || diff < ret) ret = diff;
+        break;
+    }
+    return ret;
+}
+
+/* Runs the expired timeouts, as main_loop does before each poll. */
+void inproc_server_run_timeouts(void)
+{
+    set_current_time();
+    get_next_timeout( NULL );
+}
+
+void main_loop(void)
+{
+    tw_unsupported( "the wineserver's main_loop (in-process, the server has no poll loop)" );
+}
+#else
+
