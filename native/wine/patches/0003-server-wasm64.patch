wineserver for wasm64 (docs/design/wine-unix.md, sections 2 and 3).

The guest is AMD64: guest branches of __x86_64__ take __wasm64__; host-CPU
branches keep their generic paths.

diff --git a/server/registry.c b/server/registry.c
index bb7897e..cf761d8 100644
--- a/server/registry.c
+++ b/server/registry.c
@@ -1850,7 +1850,7 @@ static void init_supported_machines(void)
     unsigned int count = 0;
 #ifdef __i386__
     if (prefix_type == PREFIX_32BIT) supported_machines[count++] = IMAGE_FILE_MACHINE_I386;
-#elif defined(__x86_64__)
+#elif defined(__x86_64__) || defined(__wasm64__)  /* wasm64: the guest is AMD64 */
     if (prefix_type == PREFIX_64BIT) supported_machines[count++] = IMAGE_FILE_MACHINE_AMD64;
     supported_machines[count++] = IMAGE_FILE_MACHINE_I386;
 #elif defined(__arm__)
