+/* Tempwind (wine-unix.md, section 7): the server's session blocks are ranges
+ * of one reservation in the same memory (patch 0203), so the view is the
+ * reservation from the rounded offset to its end, as Wine's view of size 0
+ * runs to the section's end; no section is opened or mapped. */
+static NTSTATUS map_shared_session_block( SIZE_T offset, SIZE_T size, struct session_block **ret )
+{
+    SIZE_T off = offset - (offset % system_info.AllocationGranularity);
+    struct session_block *block;
+    size_t view_size;
+
+    assert( offset + size > offset );
+
+    if (!(block = calloc( 1, sizeof(*block) ))) return STATUS_NO_MEMORY;
+    block->data = tw_session_view( off, &view_size );
+    block->size = view_size;
+    block->offset = off;
+    assert( block->offset + block->size > block->offset );
+    list_add_tail( &session_blocks, &block->entry );
+    *ret = block;
+    return STATUS_SUCCESS;
+}
