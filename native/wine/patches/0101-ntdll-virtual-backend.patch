+#ifdef __wasm64__
+/* No host mmap (docs/design/wine-unix.md, section 6): these calls go to the
+ * backend in native/wine/src/virtual_wasm.c, which keeps its own record of
+ * the maps on the one wasm memory. */
+void *tw_mmap( void *addr, size_t len, int prot, int flags, int fd, off_t offset );
+int tw_munmap( void *addr, size_t len );
+int tw_mprotect( void *addr, size_t len, int prot );
+int tw_madvise( void *addr, size_t len, int advice );
+int tw_msync( void *addr, size_t len, int flags );
+#define mmap tw_mmap
+#define munmap tw_munmap
+#define mprotect tw_mprotect
+#define madvise tw_madvise
+#define msync tw_msync
+#endif
