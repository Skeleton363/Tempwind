 /* allocate anonymous mmap() memory at any address */
 void *anon_mmap_alloc( size_t size, int prot )
 {
+#ifdef __wasm64__
+    /* Wine's own bookkeeping lives in the host heap (wine-unix.md, section 4):
+     * the view blocks, pages_vprot, the virtual heap, the fd and sync caches. */
+    void *ptr;
+
+    assert( !(size & host_page_mask) );
+    if (!(ptr = aligned_alloc( host_page_size, size ))) return MAP_FAILED;
+    return memset( ptr, 0, size );
+#else
     assert( !(size & host_page_mask) );
 
     return mmap( NULL, size, prot, MAP_PRIVATE | MAP_ANON, -1, 0 );
+#endif
 }
 
