+#ifdef __wasm64__
+/***********************************************************************
+ *           check_guest_buffer
+ *
+ * wine-unix.md, section 6: a bad guest pointer doesn't fault, so the
+ * buffer checks look at the views. Every page must be committed and not a
+ * guard page, readable for a read, writable or write-copy for a write. A
+ * write records itself on write-watched pages, as the fault would. A buffer
+ * in the host region is the Unix side's own memory and passes.
+ */
+static BOOL check_guest_buffer( const void *ptr, SIZE_T size, BOOL write )
+{
+    const char *end = (const char *)ptr + size;
+    char *page;
+    BOOL ret = TRUE;
+
+    if (end < (const char *)ptr) return FALSE;
+    if ((ULONG_PTR)ptr >= 0x80000000 && (ULONG_PTR)end <= 0x100000000) return TRUE;
+
+    mutex_lock( &virtual_mutex );
+    for (page = ROUND_ADDR( ptr, page_mask ); page < end; page += page_size)
+    {
+        struct file_view *view = find_view( page, 0 );
+        BYTE vprot = get_page_vprot( page );
+
+        if (!view || !(vprot & VPROT_COMMITTED) || (vprot & VPROT_GUARD) ||
+            !(get_unix_prot( vprot & ~VPROT_WRITEWATCH ) & (write ? PROT_WRITE : PROT_READ)))
+        {
+            ret = FALSE;
+            break;
+        }
+    }
+    if (ret && write)
+    {
+        for (page = ROUND_ADDR( ptr, page_mask ); page < end; page += page_size)
+        {
+            struct file_view *view = find_view( page, 0 );
+
+            if ((view->protect & VPROT_WRITEWATCH) && (get_page_vprot( page ) & VPROT_WRITEWATCH))
+                set_page_vprot_bits( page, page_size, 0, VPROT_WRITEWATCH );
+        }
+    }
+    mutex_unlock( &virtual_mutex );
+    return ret;
+}
+#endif
+
